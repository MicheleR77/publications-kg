   "@id": "publication/2024_Russo_MultimediaPhotogrammetry",
   "@type": "ScholarlyArticle",
   "identifier": "2024_Russo_MultimediaPhotogrammetry",
   "name": "Multimedia photogrammetry 2.0. A first step for underwater cultural heritage application",
   "datePublished": "2024",
   "kg:publicationType": "Conference paper",
   "author": {
    "@list": [

  {
   "@id": "publication/2026_Russo_MultiLayered3DSurvey",
   "@type": "ScholarlyArticle",
   "identifier": "2026_Russo_MultiLayered3DSurvey",
   "name": "Multi-Layered 3D Survey Process to Represent Visible and Invisible Data",
   "datePublished": "2026",
   "kg:publicationType": "Conference paper",
   "author": {
    "@list": [
     {
      "@id": "person/russo-michele"
     },
     {
      "@id": "person/cera-valeria"
     },
     {
      "@id": "person/casciola-martina"
     },
     {
      "@id": "person/porcu-maurizio"
     }
    ]
   },
   "abstract": "Over the last 25 years, active and passive 3D survey techniques applied in the Cultural Heritage domain have achieved a high degree of reliability. However, integrating non-visible data acquisition methods—such as thermography, sonar, and radar—remains underdeveloped regarding data fusion and visual representation. The research addresses this gap by combining heterogeneous datasets from 3D laser scanning, photogrammetry, and ground-penetrating radar. The authors examine how to manage and present this integrated information to enhance architectural understanding, bridging visible and hidden structural information for comprehensive building analysis.",
   "inLanguage": "ENG",
   "pagination": "415-422",
   "issn": "2194-9034",
   "url": "https://isprs-archives.copernicus.org/articles/XLVIII-2-W12-2026/415/2026/",

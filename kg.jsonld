  {
   "@id": "publication/2019_Carnevali_RailwayBIM",
   "@type": "ScholarlyArticle",
   "identifier": "2019_Carnevali_RailwayBIM",
   "name": "Built Information Modeling for the 3D Reconstruction of Modern Railway Stations",
   "datePublished": "2019",
   "kg:publicationType": "Journal article",
   "author": {

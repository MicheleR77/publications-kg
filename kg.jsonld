   "@id": "publication/2024_Vitali_BastionSanMaurizio",
   "@type": "ScholarlyArticle",
   "identifier": "2024_Vitali_BastionSanMaurizio",
   "name": "Study and representation of the bastion of San Maurizio in Turin: an educational experience",
   "datePublished": "2024",
   "kg:publicationType": "Conference paper",
   "author": {
    "@list": [
     {
      "@id": "person/vitali-marco"
     },
     {
      "@id": "person/rodriguez-navarro-pablo"

  {
   "@id": "publication/2022_Russo_LowCostSculpture",
   "@type": "ScholarlyArticle",
   "identifier": "2022_Russo_LowCostSculpture",
   "name": "Low-cost 3D techniques for real sculptural twins in the museum domain",
   "datePublished": "2022",
   "kg:publicationType": "Conference paper",
   "author": {
    "@list": [
     {
      "@id": "person/russo-michele"
     },
     {
      "@id": "person/senatore-luca-james"
     }
    ]
   },
   "abstract": "This contribution is part of a broader study of Cultural Heritage valorisation, defining a workflow for creating full-scale copies of statues using non-contact acquisition tools and 3D printing to enable tactile enjoyment. The research tested low-cost active and passive sensors to acquire a statue at Ostia Antica in Rome, evaluating their metrological performance. The study verified the morphological reliability of different copies produced with varied methods and materials, validating the production process for statuary replicas and establishing potential protocols for mass acquisition of artifacts in three dimensions.",
   "inLanguage": "ENG",
   "pagination": "229-236",
   "issn": "2194-9034",
   "url": "https://isprs-archives.copernicus.org/articles/XLVIII-2-W1-2022/229/2022/",

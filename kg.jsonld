   "@id": "publication/2024_Russo_AutoTagDetection",
   "@type": "ScholarlyArticle",
   "identifier": "2024_Russo_AutoTagDetection",
   "name": "Automatic tag detection in multimedia survey condition",
   "datePublished": "2024",
   "kg:publicationType": "Conference paper",
   "author": {
    "@list": [
     {
      "@id": "person/russo-michele"
     },

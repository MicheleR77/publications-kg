  {
   "@id": "publication/2026_Flenghi_ByzantineMosaic",
   "@type": "ScholarlyArticle",
   "identifier": "2026_Flenghi_ByzantineMosaic",
   "name": "From Fragmented Repertoires to a Property Graph: A Queryable Atlas of Byzantine Geometric Mosaic Bands for Architectural Heritage",
   "datePublished": "2026",
   "kg:publicationType": "Conference paper",
   "author": {
    "@list": [
     {
      "@id": "person/flenghi-giulia"
     },
     {
      "@id": "person/abergel-violette"
     },
     {
      "@id": "person/russo-michele"
     }
    ]
   },
   "abstract": "This research addresses the challenge of studying architectural decorative elements by proposing a methodological framework for constructing an interrogable Atlas of architectural ornament based on a property-graph model. The approach integrates photogrammetric surveys, vector drawings, controlled terminology, and a graph database to systematically connect visual documentation, typological classifications, contextual data, and bibliographic sources. The methodology was tested on Byzantine geometric mosaic bands (5th–12th centuries) from monuments in Ravenna and Rome, encompassing 34 classes across wall and pavement surfaces. The resulting system enables cross-site and cross-period comparisons while maintaining connections to supporting documentation, offering a scalable and verifiable framework for cumulative knowledge building and future extensions in comparative ornament research.",
   "inLanguage": "ENG",
   "pagination": "151-158",
   "issn": "2194-9034",
   "url": "https://isprs-archives.copernicus.org/articles/XLVIII-2-W12-2026/151/2026/",

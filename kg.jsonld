  {
   "@id": "publication/2025_Russo_UnderwaterPhotogrammetry",
   "@type": "ScholarlyArticle",
   "identifier": "2025_Russo_UnderwaterPhotogrammetry",
   "name": "Automated marker detection and time series analysis for through-water photogrammetry",
   "datePublished": "2025",
   "kg:publicationType": "Conference paper",
   "author": {
    "@list": [
     {
      "@id": "person/russo-michele"
     },
     {
      "@id": "person/martelli-luca"
     },
     {
      "@id": "person/ravanelli-roberta"
     },
     {
      "@id": "person/pini-agnese"
     }
    ]
   },
   "abstract": "Through-water photogrammetry for surveys of Underwater Cultural Heritage (UCH) is a problem addressed by scholars from multiple perspectives. The research tackles challenges including light attenuation, water optical variations, surface undulation, and refraction effects. The authors developed a mathematical model to represent refraction across different water levels and motion states. Their methodology employed two consumer-grade cameras for image pair acquisition and a high-speed monocular camera for video sequences, enabling temporal analysis of underwater photographic phenomena in shallow water environments.",
   "inLanguage": "ENG",
   "pagination": "263-270",
   "issn": "2194-9034",
   "url": "https://isprs-archives.copernicus.org/articles/XLVIII-2-W10-2025/263/2025/",
   "volumeNumber": "XLVIII-2/W10-2025",
   "sameAs": [
    "https://doi.org/10.5194/isprs-archives-XLVIII-2-W10-2025-263-2025",
    "https://iris.uniroma1.it/handle/11573/1742883"
   ],
   "kg:openAccess": "yes",
   "kg:anvurScientificArea08": "yes",
   "kg:anvurClassA": "yes",
   "isPartOf": {
    "@id": "venue/international-archives-of-the-photogrammetry-remote-sensing-and-spatial-informat"
   },
   "kg:conference": {

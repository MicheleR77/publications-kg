  {
   "@id": "publication/2024_Flenghi_TalkingCities",
   "@type": "Chapter",
   "identifier": "2024_Flenghi_TalkingCities",
   "name": "Talking City. Voices of Hidden History in the Architecture and Urban Places of Rome",
   "datePublished": "2024",
   "kg:publicationType": "Book chapter",
   "author": {
    "@list": [
     {
      "@id": "person/flenghi-giulia"
     },
     {
      "@id": "person/ippoliti-elena"
     },
     {
      "@id": "person/meschini-alessandra"
     },
     {
      "@id": "person/russo-michele"
     },
     {
      "@id": "person/tomasella-noemi"
     }
    ]
   },
   "abstract": "Our cities represent a complex blend of material and immaterial culture. This research focuses on writings traced on building surfaces throughout history—graffiti and minor epigraphs—as keys to understanding past societies. These inscriptions, particularly those by common people rather than ruling classes, constitute fundamental historical resources revealing 'the people's voice' and intangible heritage. Many remain hidden or barely visible in urban environments. The study maps such traces in Rome, a city with deep cultural stratification, to construct narrative itineraries. By enhancing these historical sources through architectural routes, the city becomes a storytelling system that unveils hidden heritage and gives voice to real-life stories embedded in urban places.",
   "inLanguage": "ENG",
   "pagination": "122-146",
   "isbn": "9798338843420",
   "url": "https://journals.ap2.pt/index.php/indigo/article/view/979/570",
   "sameAs": [
    "https://doi.org/10.48619/indigo.v0i0.979",
    "https://iris.uniroma1.it/handle/11573/1719465"
   ],
   "kg:openAccess": "yes",
   "isPartOf": {

<https://micheler77.github.io/publications-kg/publication/2023_Russo_CanossaBIM> a :ScholarlyArticle ;
    kg:anvurClassA "yes" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:openAccess "yes" ;
    kg:publicationType "Journal article" ;
    :about <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/fortifications>,
        <https://micheler77.github.io/publications-kg/keyword/multi-scale-representation>,
        <https://micheler77.github.io/publications-kg/keyword/reconstructive-bim-modelling> ;
    :abstract "Medieval fortifications often have close ties with the territory and reduced accessibility. The integrated use of drawing tools such as surveying, graphic restitution, and BIM modelling makes it possible to initiate comparative and interpretative analyses in order to define new knowledge models. The study focused on the Castle of Canossa, the epicentre of crucial events during the Middle Ages. The objective was to unveil part of the mystery surrounding the evolution of its architecture and lay the groundwork for an in-depth interdisciplinary study." ;
    :author ( <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/panarotto-federico> <https://micheler77.github.io/publications-kg/person/flenghi-giulia> <https://micheler77.github.io/publications-kg/person/russo-valentina> <https://micheler77.github.io/publications-kg/person/pellegrinelli-alberto> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/canossa-reggio-emilia-italy> ;
    :datePublished "2023" ;
    :identifier "2023_Russo_CanossaBIM" ;
    :inLanguage "ITA/ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/disegnare-idee-immagini> ;
    :issn "1123-9247" ;
    :issueNumber "67" ;
    :name "Il Castello di Canossa: Interpretazione di una fortificazione misteriosa" ;
    :pagination "34-45" ;
    :sameAs "https://doi.org/10.61020/11239247-202367-05",

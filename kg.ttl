<https://micheler77.github.io/publications-kg/publication/2023_Spallone_PiffettiCIPA> a :ScholarlyArticle ;
    kg:anvurClassA "yes" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/sculptural-design> ;
    kg:conference [ :location "Florence, Tuscany, Italy" ;
            :name "CIPA 2023 – Documenting, Understanding, Preserving Cultural Heritage" ;
            :year "2023" ] ;
    kg:openAccess "yes" ;

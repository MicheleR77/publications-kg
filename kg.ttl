<https://micheler77.github.io/publications-kg/publication/2026_Russo_MultiLayered3DSurvey> a :ScholarlyArticle ;
    kg:anvurClassA "yes" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:conference [ :location "Ancona, Marche, Italy" ;
            :name "3DARCH 2026" ;
            :year "2026" ] ;
    kg:openAccess "yes" ;
    kg:publicationType "Conference paper" ;
    :about <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/non-destructive-testing>,
        <https://micheler77.github.io/publications-kg/keyword/point-cloud>,
        <https://micheler77.github.io/publications-kg/keyword/reality-based-modelling>,
        <https://micheler77.github.io/publications-kg/keyword/sensor-integration> ;
    :abstract "Over the last 25 years, active and passive 3D survey techniques applied in the Cultural Heritage domain have achieved a high degree of reliability. However, integrating non-visible data acquisition methods—such as thermography, sonar, and radar—remains underdeveloped regarding data fusion and visual representation. The research addresses this gap by combining heterogeneous datasets from 3D laser scanning, photogrammetry, and ground-penetrating radar. The authors examine how to manage and present this integrated information to enhance architectural understanding, bridging visible and hidden structural information for comprehensive building analysis." ;
    :author ( <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/cera-valeria> <https://micheler77.github.io/publications-kg/person/casciola-martina> <https://micheler77.github.io/publications-kg/person/porcu-maurizio> ) ;
    :datePublished "2026" ;
    :identifier "2026_Russo_MultiLayered3DSurvey" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/international-archives-of-the-photogrammetry-remote-sensing-and-spatial-informat> ;
    :issn "2194-9034" ;
    :name "Multi-Layered 3D Survey Process to Represent Visible and Invisible Data" ;
    :pagination "415-422" ;
    :sameAs "https://doi.org/10.5194/isprs-archives-XLVIII-2-W12-2026-415-2026",
        "https://iris.uniroma1.it/handle/11573/1762131" ;
    :url "https://isprs-archives.copernicus.org/articles/XLVIII-2-W12-2026/415/2026/" ;
    :volumeNumber "XLVIII-2/W12-2026" .

<https://micheler77.github.io/publications-kg/publication/2026_Russo_PalazzoCarignano> a :ScholarlyArticle ;
    kg:anvurClassA "yes" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:openAccess "yes" ;
    kg:publicationType "Journal article" ;
    :about <https://micheler77.github.io/publications-kg/keyword/algorithmic-modelling>,
        <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/geometry>,
        <https://micheler77.github.io/publications-kg/keyword/guarino-guarini>,
        <https://micheler77.github.io/publications-kg/keyword/reconstructive-drawing> ;
    :abstract "This paper examines the relationship between geometry and architecture in Guarino Guarini's design and building activities. The study was performed using methodologies that integrate and interconnect analyses, redrawings, and interpretations. A case study of the double staircase of Palazzo Carignano was performed by comparing autograph drawings with a building survey. Redrawing of the original plates and visual programming language modeling of the point cloud section enabled thorough comparison between the ideation and construction phases. The analyses shed new light on different original drawings to explore the Guarinian design process. The link between geometry and architecture is evident in not only his theoretical works, but also his design method and realized buildings." ;
    :author ( <https://micheler77.github.io/publications-kg/person/spallone-roberta> <https://micheler77.github.io/publications-kg/person/vitali-marco> <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/natta-fabrizio> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/turin-piedmont-italy> ;
    :datePublished "2026" ;
    :identifier "2026_Russo_PalazzoCarignano" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/nexus-network-journal> ;
    :issn "1522-4600" ;
    :issueNumber "3" ;
    :name "Geometric Studies and Algorithmic Modeling of the Double Staircase of Palazzo Carignano" ;
    :pagination "619-643" ;
    :sameAs "https://doi.org/10.1007/s00004-026-00880-0",
        "https://iris.uniroma1.it/handle/11573/1767655" ;
    :url "https://doi.org/10.1007/s00004-026-00880-0" ;
    :volumeNumber "28" .

<https://micheler77.github.io/publications-kg/publication/2026_Spallone_CarignanoHBIM> a :ScholarlyArticle ;
    kg:anvurClassA "yes" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:conference [ :location "Ancona, Marche, Italy" ;
            :name "3DARCH 2026" ;
            :year "2026" ] ;
    kg:openAccess "yes" ;
    kg:publicationType "Conference paper" ;
    :about <https://micheler77.github.io/publications-kg/keyword/baroque-architecture>,
        <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/guarino-guarini>,
        <https://micheler77.github.io/publications-kg/keyword/hbim>,
        <https://micheler77.github.io/publications-kg/keyword/level-of-accuracy> ;
    :abstract "Baroque architecture presents considerable morphological complexities relating to structural systems, distributive characteristics, and decorative elements. Palazzo Carignano in Turin, designed by Guarino Guarini from 1679, is a quintessential example of the period. The research addresses the challenge of documenting this complex building through integrated digital surveying and HBIM modeling of both structural and decorative systems. The Level of Accuracy (LOA) serves as a critical control parameter connecting the surveying and modeling phases, representing a central focus of this study on heritage documentation workflows." ;
    :author ( <https://micheler77.github.io/publications-kg/person/spallone-roberta> <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/vitali-marco> <https://micheler77.github.io/publications-kg/person/natta-fabrizio> <https://micheler77.github.io/publications-kg/person/bruschi-giovanni> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/turin-piedmont-italy> ;
    :datePublished "2026" ;
    :identifier "2026_Spallone_CarignanoHBIM" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/international-archives-of-the-photogrammetry-remote-sensing-and-spatial-informat> ;
    :issn "2194-9034" ;
    :name "A Scan-to-HBIM Workflow to Trace the Level of Modelling Accuracy. The Case of Palazzo Carignano in Turin" ;
    :pagination "455-462" ;
    :sameAs "https://doi.org/10.5194/isprs-archives-XLVIII-2-W12-2026-455-2026",
        "https://iris.uniroma1.it/handle/11573/1762132" ;
    :url "https://isprs-archives.copernicus.org/articles/XLVIII-2-W12-2026/455/2026/" ;
    :volumeNumber "XLVIII-2/W12-2026" .


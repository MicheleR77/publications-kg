<https://micheler77.github.io/publications-kg/publication/2023_Russo_PiffettiAcquisition> a :ScholarlyArticle ;
    kg:anvurClassA "yes" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/sculptural-design> ;
    kg:conference [ :location "Florence, Tuscany, Italy" ;
            :name "CIPA 2023 – Documenting, Understanding, Preserving Cultural Heritage" ;
            :year "2023" ] ;
    kg:openAccess "yes" ;
    kg:publicationType "Conference paper" ;
    kg:scopusId "2-s2.0-85164724467" ;
    :about <https://micheler77.github.io/publications-kg/keyword/3d-laser-scanning>,
        <https://micheler77.github.io/publications-kg/keyword/cultural-heritage>,
        <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/reality-based-modelling> ;
    :abstract "Integrated surveying with active and passive systems is a well-established process for understanding artifacts at different scales and levels of complexity. However, challenges persist when dealing with reflective surfaces and uncontrolled lighting conditions. This research examines the Piffetti Library, an 1800s wooden artifact housed in Rome's Quirinale Palace. The study tested multiple 3D acquisition techniques to address the artifact's complexity—including glossy finishes, sculptural details, and spatial constraints with difficult lighting. The researchers compared different methodologies to identify strengths and weaknesses of each approach, establishing a replicable protocol for similar heritage objects." ;
    :author ( <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/spallone-roberta> <https://micheler77.github.io/publications-kg/person/senatore-luca-james> <https://micheler77.github.io/publications-kg/person/flenghi-giulia> <https://micheler77.github.io/publications-kg/person/morozzi-luisa> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/rome-lazio-italy> ;
    :datePublished "2023" ;
    :identifier "2023_Russo_PiffettiAcquisition" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/international-archives-of-the-photogrammetry-remote-sensing-and-spatial-informat> ;
    :issn "2194-9034" ;
    :name "Integrated 3D acquisition of complex wooden artefacts: The Piffetti's library in Quirinale palace (Rome)" ;
    :pagination "1379-1386" ;
    :sameAs "https://doi.org/10.5194/isprs-archives-XLVIII-M-2-2023-1379-2023",
        "https://iris.uniroma1.it/handle/11573/1684604" ;
    :url "https://isprs-archives.copernicus.org/articles/XLVIII-M-2-2023/1379/2023/" ;
    :volumeNumber "XLVIII-M-2-2023" .


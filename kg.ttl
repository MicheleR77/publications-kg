<https://micheler77.github.io/publications-kg/publication/2024_Flenghi_TalkingCities> a :Chapter ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/urban> ;
    kg:openAccess "yes" ;
    kg:publicationType "Book chapter" ;
    :about <https://micheler77.github.io/publications-kg/keyword/cultural-heritage>,
        <https://micheler77.github.io/publications-kg/keyword/street-art>,
        <https://micheler77.github.io/publications-kg/keyword/visual-storytelling> ;
    :abstract "Our cities represent a complex blend of material and immaterial culture. This research focuses on writings traced on building surfaces throughout history—graffiti and minor epigraphs—as keys to understanding past societies. These inscriptions, particularly those by common people rather than ruling classes, constitute fundamental historical resources revealing 'the people's voice' and intangible heritage. Many remain hidden or barely visible in urban environments. The study maps such traces in Rome, a city with deep cultural stratification, to construct narrative itineraries. By enhancing these historical sources through architectural routes, the city becomes a storytelling system that unveils hidden heritage and gives voice to real-life stories embedded in urban places." ;
    :author ( <https://micheler77.github.io/publications-kg/person/flenghi-giulia> <https://micheler77.github.io/publications-kg/person/ippoliti-elena> <https://micheler77.github.io/publications-kg/person/meschini-alessandra> <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/tomasella-noemi> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/rome-lazio-italy> ;
    :datePublished "2024" ;
    :identifier "2024_Flenghi_TalkingCities" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/disseminate-analyse-understand-graffiti-scapes-proceedings-of-the-goindigo-2023-> ;
    :isbn "9798338843420" ;
    :name "Talking City. Voices of Hidden History in the Architecture and Urban Places of Rome" ;
    :pagination "122-146" ;
    :sameAs "https://doi.org/10.48619/indigo.v0i0.979",
        "https://iris.uniroma1.it/handle/11573/1719465" ;
    :url "https://journals.ap2.pt/index.php/indigo/article/view/979/570" .


<https://micheler77.github.io/publications-kg/publication/2018_Russo_PalazzoVerginese> a :Book ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:openAccess "yes" ;
    kg:publicationType "Monograph" ;
    :about <https://micheler77.github.io/publications-kg/keyword/cultural-heritage>,
        <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/interpretive-reconstruction>,
        <https://micheler77.github.io/publications-kg/keyword/multi-scale-representation>,
        <https://micheler77.github.io/publications-kg/keyword/reconstructive-drawing> ;
    :abstract "The book examines the 'Delizia del Verginese,' investigating this Renaissance estate through architectural representation and spatial analysis. It traces the structure's historical context, design genesis, geometric organization, and relationship with its surrounding landscape and gardens. Using surveying and representational methods, the work documents the building through plans, sections, and 3D modeling, ultimately proposing communication strategies for cultural heritage promotion and preservation." ;
    :author ( <https://micheler77.github.io/publications-kg/person/russo-michele> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/voghiera-ferrara-italy> ;
    :datePublished "2018" ;
    :identifier "2018_Russo_PalazzoVerginese" ;
    :inLanguage "ITA" ;
    :isbn "9788893770590" ;
    :name "Il Palazzo del Verginese: una Delizia Estense nascosta" ;
    :pagination "222" ;
    :publisher "Sapienza Università Editrice" ;
    :sameAs "https://iris.uniroma1.it/handle/11573/1095742" ;
    :url "http://www.editricesapienza.it/sites/default/files/5652_Russo_Palazzo_Verginese_OA.pdf" .


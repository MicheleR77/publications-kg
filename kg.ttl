<https://micheler77.github.io/publications-kg/publication/2025_Russo_AlessandriaLuccaFORTMED> a :ScholarlyArticle ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:conference [ :location "Caserta, Campania, Italy" ;
            :name "FORTMED 2025 – International Conference on Fortification of the Mediterranean Coast" ;
            :year "2025" ] ;
    kg:openAccess "yes" ;
    kg:publicationType "Conference paper" ;
    :about <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/fortifications>,
        <https://micheler77.github.io/publications-kg/keyword/multi-scale-representation> ;
    :abstract "In military architecture, the city wall between towers or bastions has architectural-structural characteristics related to the defensive and offensive systems used. This paper examines city fortifications through digital survey techniques, comparing the walls of Alessandria and Lucca. Researchers integrated multiple surveying methodologies to document these complex structures' morphological details while maintaining accuracy. The study emphasizes how metric control ensures reliability when analyzing different building systems and comparing findings with historical military treatises, ultimately supporting parametric modeling approaches." ;
    :author ( <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/asciutti-michele> <https://micheler77.github.io/publications-kg/person/flenghi-giulia> <https://micheler77.github.io/publications-kg/person/casciola-martina> <https://micheler77.github.io/publications-kg/person/bertoncini-sabatini-paolo> <https://micheler77.github.io/publications-kg/person/caroti-gabriella> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/alessandria-piedmont-italy>,
        <https://micheler77.github.io/publications-kg/place/lucca-tuscany-italy> ;
    :datePublished "2025" ;
    :identifier "2025_Russo_AlessandriaLuccaFORTMED" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/international-conference-on-fortification-of-the-mediterranean-coast-2025-vol-xx> ;
    :isbn "9788885556379" ;
    :name "Survey experiences of city walls of Alessandria and Lucca: an overview" ;
    :pagination "1189-1196" ;
    :sameAs "https://doi.org/10.4995/Fortmed2025.2025.20377",
        "https://iris.uniroma1.it/handle/11573/1739393" ;

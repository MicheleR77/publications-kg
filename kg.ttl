<https://micheler77.github.io/publications-kg/publication/2025_Spallone_PiffettiLibrary> a :ScholarlyArticle ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/sculptural-design> ;
    kg:conference [ :location "Berlin, Germany" ;
            :name "EVA Berlin 2025" ;
            :year "2025" ] ;
    kg:openAccess "yes" ;
    kg:publicationType "Conference paper" ;
    :about <https://micheler77.github.io/publications-kg/keyword/accessibility>,
        <https://micheler77.github.io/publications-kg/keyword/augmented-reality>,
        <https://micheler77.github.io/publications-kg/keyword/cultural-heritage>,
        <https://micheler77.github.io/publications-kg/keyword/reconstructive-drawing>,
        <https://micheler77.github.io/publications-kg/keyword/virtual-reality> ;
    :abstract "This interdisciplinary research project aims to enhance knowledge accessibility in museums by digitally reconstructing Pietro Piffetti's 18th-century library. Originally located in Villa della Regina (Turin), the cabinetmaking masterpiece was moved to the Quirinale. The team employed archival research, 3D surveying, digital modeling, and texturing to recreate the library. They developed augmented and virtual reality applications enabling interactive public engagement with the reconstructed work in its original architectural context." ;
    :author ( <https://micheler77.github.io/publications-kg/person/spallone-roberta> <https://micheler77.github.io/publications-kg/person/teolato-chiara> <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/vitali-marco> <https://micheler77.github.io/publications-kg/person/palma-valerio> <https://micheler77.github.io/publications-kg/person/pupi-enrico> <https://micheler77.github.io/publications-kg/person/rinascimento-martina> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/turin-piedmont-italy> ;
    :datePublished "2025" ;
    :identifier "2025_Spallone_PiffettiLibrary" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/eva-berlin-2025-electronic-media-and-visual-arts-28th-eva-berlin-conference> ;
    :name "Visualising Piffetti's library in Villa della Regina museum: an interdisciplinary digital project for knowledge accessibility" ;
    :pagination "143-152" ;
    :publisher "arthistoricum.net" ;
    :sameAs "https://doi.org/10.11588/arthistoricum.1568.c24085",
        "https://iris.uniroma1.it/handle/11573/1757198" ;
    :url "https://books.ub.uni-heidelberg.de/arthistoricum/catalog/book/1568/chapter/24085" .

<https://micheler77.github.io/publications-kg/publication/2026_Flenghi_ByzantineMosaic> a :ScholarlyArticle ;
    kg:anvurClassA "yes" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:conference [ :location "Ancona, Marche, Italy" ;
            :name "3DARCH 2026" ;
            :year "2026" ] ;
    kg:openAccess "yes" ;
    kg:publicationType "Conference paper" ;
    :about <https://micheler77.github.io/publications-kg/keyword/cultural-heritage>,
        <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/knowledge-graph>,
        <https://micheler77.github.io/publications-kg/keyword/mosaic>,
        <https://micheler77.github.io/publications-kg/keyword/photogrammetry> ;
    :abstract "This research addresses the challenge of studying architectural decorative elements by proposing a methodological framework for constructing an interrogable Atlas of architectural ornament based on a property-graph model. The approach integrates photogrammetric surveys, vector drawings, controlled terminology, and a graph database to systematically connect visual documentation, typological classifications, contextual data, and bibliographic sources. The methodology was tested on Byzantine geometric mosaic bands (5th–12th centuries) from monuments in Ravenna and Rome, encompassing 34 classes across wall and pavement surfaces. The resulting system enables cross-site and cross-period comparisons while maintaining connections to supporting documentation, offering a scalable and verifiable framework for cumulative knowledge building and future extensions in comparative ornament research." ;
    :author ( <https://micheler77.github.io/publications-kg/person/flenghi-giulia> <https://micheler77.github.io/publications-kg/person/abergel-violette> <https://micheler77.github.io/publications-kg/person/russo-michele> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/ravenna-emilia-romagna-italy>,
        <https://micheler77.github.io/publications-kg/place/rome-lazio-italy> ;
    :datePublished "2026" ;
    :identifier "2026_Flenghi_ByzantineMosaic" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/international-archives-of-the-photogrammetry-remote-sensing-and-spatial-informat> ;
    :issn "2194-9034" ;
    :name "From Fragmented Repertoires to a Property Graph: A Queryable Atlas of Byzantine Geometric Mosaic Bands for Architectural Heritage" ;
    :pagination "151-158" ;
    :sameAs "https://doi.org/10.5194/isprs-archives-XLVIII-2-W12-2026-151-2026",
        "https://iris.uniroma1.it/handle/11573/1761640" ;
    :url "https://isprs-archives.copernicus.org/articles/XLVIII-2-W12-2026/151/2026/" ;
    :volumeNumber "XLVIII-2/W12-2026" .


<https://micheler77.github.io/publications-kg/publication/2025_Flenghi_OrdiniNeurali> a :ScholarlyArticle ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/not-applicable> ;
    kg:conference [ :location "Rome, Lazio, Italy" ;
            :name "46° Convegno Internazionale dei Docenti delle Discipline della Rappresentazione (UID 2025) – ÉKPHRASIS" ;
            :year "2025" ] ;
    kg:openAccess "yes" ;
    kg:publicationType "Conference paper" ;
    :about <https://micheler77.github.io/publications-kg/keyword/deep-learning>,
        <https://micheler77.github.io/publications-kg/keyword/generative-ai>,
        <https://micheler77.github.io/publications-kg/keyword/historical-architecture>,
        <https://micheler77.github.io/publications-kg/keyword/text-to-image> ;
    :abstract "Neural Network application for visual content generation is a hot topic with multidisciplinary challenges. The automatic generation of images (text-to-image) and videos (text-to-video) involves multiple application domains and introduces the problem of content reliability. The research examines digital hallucinations—unexpected errors and artifacts in AI-generated images—conducting comparative testing across different text-to-image platforms focused on generating architectural imagery based on classical treatises, specifically the Doric order. The findings demonstrate that current deep learning tools struggle to produce scientifically accurate architectural content, revealing significant limitations in these technologies despite their potential." ;
    :author ( <https://micheler77.github.io/publications-kg/person/flenghi-giulia> <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/senatore-luca-james> ) ;
    :datePublished "2025" ;
    :identifier "2025_Flenghi_OrdiniNeurali" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/ekphrasis-descrizioni-nello-spazio-della-rappresentazione-descriptions-in-the-sp> ;
    :isbn "9788835182412" ;
    :name "Allucinazione eidomatica degli ordini architettonici nell'era delle Reti Neurali" ;
    :pagination "2777-2792" ;
    :publisher "FrancoAngeli" ;
    :sameAs "https://doi.org/10.3280/oa-1430-c900",
        "https://iris.uniroma1.it/handle/11573/1746642" ;
    :url "https://doi.org/10.3280/oa-1430-c900" .


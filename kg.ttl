<https://micheler77.github.io/publications-kg/publication/2014_Guidi_3DSurveyArchaeological> a :ScholarlyArticle ;
    kg:anvurClassA "no" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:openAccess "yes" ;
    kg:publicationType "Journal article" ;
    kg:scopusId "2-s2.0-84895651464" ;
    :about <https://micheler77.github.io/publications-kg/keyword/archaeological-survey>,
        <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/interpretive-reconstruction>,
        <https://micheler77.github.io/publications-kg/keyword/photogrammetry> ;
    :abstract "3D digital acquisition techniques may greatly help in documenting an archaeological site, supporting traditional analytical methods focused on excavations and stratigraphic analysis. Accurate digital representations can serve as a foundation for creating scientifically rigorous virtual reconstructions that integrate historical information from multiple sources. The methodology emphasises iterative feedback processes to achieve optimal reconstruction solutions, assisting archaeologists with detailed visual analysis and helping technical experts avoid inaccuracies in the final virtual reconstruction. The case study applied this approach to a collection of Cham temples at My Son, a UNESCO-protected archaeological area in central Vietnam." ;
    :author ( <https://micheler77.github.io/publications-kg/person/guidi-gabriele> <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/angheleddu-davide> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/my-son-quang-nam-vietnam> ;
    :datePublished "2014" ;
    :identifier "2014_Guidi_3DSurveyArchaeological" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/digital-applications-in-archaeology-and-cultural-heritage> ;
    :issn "2212-0548" ;
    :issueNumber "2" ;
    :name "3D Survey and Virtual Reconstruction of Archaeological Sites" ;
    :pagination "55-69" ;
    :sameAs "https://doi.org/10.1016/j.daach.2014.01.001",
        "https://iris.uniroma1.it/handle/11573/905444" ;
    :url "http://hdl.handle.net/11311/864950" ;
    :volumeNumber "1" .


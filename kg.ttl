<https://micheler77.github.io/publications-kg/publication/2011_Russo_Principali> a :ScholarlyArticle ;
    kg:anvurClassA "yes" ;
    kg:anvurScientificArea08 "yes" ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/not-applicable> ;
    kg:openAccess "yes" ;
    kg:publicationType "Journal article" ;
    kg:wosId "000219322000008" ;
    :about <https://micheler77.github.io/publications-kg/keyword/3d-laser-scanning>,
        <https://micheler77.github.io/publications-kg/keyword/cultural-heritage>,
        <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/multi-scale-representation>,
        <https://micheler77.github.io/publications-kg/keyword/photogrammetry>,
        <https://micheler77.github.io/publications-kg/keyword/virtual-archaeology> ;
    :abstract "The increase of 3D acquisition and modeling techniques applied to archaeology is due principally to (i) their capacity to survey archaeological artifacts with high precision and a non-contact approach and (ii) the possibility to create 3D digital models useful for data analysis, simulation and preservation. These benefits in terms of knowledge oblige the contemporary archaeologist to acquire a better understanding of 3D acquisition and modeling principles and practice. This evidence arises from the necessity of adopting a common language for experts in 3D data management and archaeologists, with the principal aim of understanding each other's requirements and sharing the purposes of the project." ;
    :author ( <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/remondino-fabio> <https://micheler77.github.io/publications-kg/person/guidi-gabriele> ) ;
    :datePublished "2011" ;
    :identifier "2011_Russo_Principali" ;

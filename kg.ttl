<https://micheler77.github.io/publications-kg/publication/2021_Russo_MachineLearningCH> a :Chapter ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:openAccess "yes" ;
    kg:publicationType "Book chapter" ;
    :about <https://micheler77.github.io/publications-kg/keyword/cultural-heritage>,
        <https://micheler77.github.io/publications-kg/keyword/level-of-detail>,
        <https://micheler77.github.io/publications-kg/keyword/machine-learning>,
        <https://micheler77.github.io/publications-kg/keyword/point-cloud-classification> ;
    :abstract "Cultural Heritage (CH) assets comprise interconnected spatial systems where geometric classification within hierarchical structures enables proper interpretation using 3D point clouds. Machine Learning procedures enhance recurring shape recognition by assigning semantic meaning to geometric data. An interdisciplinary team developed a supervised ML approach tested on Milan Cathedral and Pomposa Abbey datasets, introducing an innovative multi-level and multi-resolution classification (MLMR) process that improves learning activity and optimizes 3D classification through hierarchical methodology." ;
    :author ( <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/grilli-eleonora> <https://micheler77.github.io/publications-kg/person/remondino-fabio> <https://micheler77.github.io/publications-kg/person/teruggi-simone> <https://micheler77.github.io/publications-kg/person/fassi-francesco> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/codigoro-ferrara-italy>,
        <https://micheler77.github.io/publications-kg/place/milan-lombardy-italy> ;
    :datePublished "2021" ;
    :identifier "2021_Russo_MachineLearningCH" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/representation-challenges-augmented-reality-and-artificial-intelligence-in-cultu> ;
    :isbn "9788835125280" ;
    :name "Machine Learning for Cultural Heritage Classification" ;
    :pagination "209-214" ;

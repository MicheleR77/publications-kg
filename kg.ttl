    kg:scopusId "2-s2.0-85164729993" ;
    :about <https://micheler77.github.io/publications-kg/keyword/accessibility>,
        <https://micheler77.github.io/publications-kg/keyword/augmented-reality>,
        <https://micheler77.github.io/publications-kg/keyword/cultural-heritage>,
        <https://micheler77.github.io/publications-kg/keyword/reconstructive-bim-modelling>,
        <https://micheler77.github.io/publications-kg/keyword/virtual-reality> ;
    :abstract "This research, funded through the PNRR Accessibility sector, reconstructs Piffetti's Library in 3D modeling. The library originally occupied a cabinet in Villa della Regina in Turin but is now housed at Palazzo del Quirinale. The interdisciplinary team combines expertise in art history, digital surveying, 3D modeling, and cultural heritage technology to create interactive visualizations through augmented reality and virtual reality, aimed at accessibility." ;
    :author ( <https://micheler77.github.io/publications-kg/person/spallone-roberta> <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/teolato-chiara> <https://micheler77.github.io/publications-kg/person/vitali-marco> <https://micheler77.github.io/publications-kg/person/palma-valerio> <https://micheler77.github.io/publications-kg/person/pupi-enrico> ) ;
    :contentLocation <https://micheler77.github.io/publications-kg/place/turin-piedmont-italy> ;
    :datePublished "2023" ;
    :identifier "2023_Spallone_PiffettiCIPA" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/international-archives-of-the-photogrammetry-remote-sensing-and-spatial-informat> ;
    :issn "2194-9034" ;
    :name "Reconstructive 3D modelling and interactive visualization for accessibility of Piffetti's library in the Villa della Regina museum (Turin)" ;
    :pagination "1485-1492" ;
    :sameAs "https://doi.org/10.5194/isprs-archives-XLVIII-M-2-2023-1485-2023",
        "https://iris.uniroma1.it/handle/11573/1684606" ;
    :url "https://isprs-archives.copernicus.org/articles/XLVIII-M-2-2023/1485/2023/" ;

<https://micheler77.github.io/publications-kg/publication/2026_Russo_BastionSurvey> a :ScholarlyArticle ;
    kg:caseStudyScale <https://micheler77.github.io/publications-kg/scale/architectural> ;
    kg:conference [ :location "Rome, Lazio, Italy" ;
            :name "FORTMED 2026 – Fortification of the Mediterranean Coast" ;
            :year "2026" ] ;
    kg:openAccess "yes" ;
    kg:publicationType "Conference paper" ;
    :about <https://micheler77.github.io/publications-kg/keyword/digital-survey>,
        <https://micheler77.github.io/publications-kg/keyword/fortifications>,
        <https://micheler77.github.io/publications-kg/keyword/multi-scale-representation> ;
    :abstract "The paper addresses documentation of fortified heritage through integrated digital surveying at multiple scales. The authors propose that surveys must operate across urban, architectural, and detailed levels to capture the complexity of these structures. They present guidelines for a 'bastion survey protocol' that harmonizes information collection across different scales while maintaining quality control and temporal continuity for asset management and preservation activities." ;
    :author ( <https://micheler77.github.io/publications-kg/person/russo-michele> <https://micheler77.github.io/publications-kg/person/caroti-gabriella> ) ;
    :datePublished "2026" ;
    :identifier "2026_Russo_BastionSurvey" ;
    :inLanguage "ENG" ;
    :isPartOf <https://micheler77.github.io/publications-kg/venue/defensive-architecture-of-the-mediterranean-vol-xxiv> ;
    :isbn "9788893774369" ;
    :name "Bastion survey protocol: operational activity framework for multi-scale surveys of fortified walls" ;
    :pagination "243-250" ;
    :publisher "Sapienza Università Editrice / edUPV" ;
    :sameAs "https://doi.org/10.4995/Fortmed2026.2026.21503",
        "https://iris.uniroma1.it/handle/11573/1762125" ;
    :url "https://ocs.editorial.upv.es/index.php/FORTMED/FORTMED2026/paper/view/21503" .

